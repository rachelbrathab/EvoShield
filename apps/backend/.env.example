# ── App ────────────────────────────────────────────────────────────────
APP_NAME=EvoShield API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# ── Database ───────────────────────────────────────────────────────────
# Local zero-setup dev (default): sqlite fallback.
# Production (Supabase pooler):
#   postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./evoshield-dev.db

# ── HTTP ───────────────────────────────────────────────────────────────
# JSON array, e.g. ["http://localhost:3000","https://app.evoshield.dev"]
CORS_ORIGINS=["http://localhost:3000"]
# Host-header allowlist (TrustedHostMiddleware). "testserver" is required by
# the test client; add your real domains in production.
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
API_V1_PREFIX=/api/v1

# ── Auth (Sprint 2) ─────────────────────────────────────────────────────
# Provider selection: "auto" (default) → Supabase when credentials are
# configured, otherwise the local provider (zero-dependency dev fallback).
# Set explicitly to "supabase" or "local" to force a mode.
AUTH_PROVIDER=auto
# httpOnly session cookie holding the access token.
SESSION_COOKIE_NAME=evoshield_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=43200
# Local-provider HS256 signing secret — >= 32 bytes (RFC 7518 §3.2). Dev default;
# generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_JWT_SECRET=dev-only-session-secret-change-me-0123456789
# Frontend origin for OAuth post-login redirects.
FRONTEND_URL=http://localhost:3000

# ── Supabase (Sprint 2+) ───────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── GitHub OAuth + API (Sprint 2/3A) ────────────────────────────────────
# OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Absolute callback URL, e.g. http://localhost:8000/api/v1/auth/oauth/github/callback
GITHUB_REDIRECT_URI=
# REST API base — override for GitHub Enterprise. The Sprint 3A repository
# integration client targets this; the OAuth flow must remain on github.com.
GITHUB_API_URL=https://api.github.com

# ── Analysis (Sprint 4A / 5A) ────────────────────────────────────────
# Provider: "fake" (simulation), "trivy" (real vulnerability scanning).
ANALYSIS_PROVIDER=fake
# Multi-scanner mode (takes precedence when set): comma-separated list of
# trivy,gitleaks,semgrep,grype. Example: ANALYSIS_SCANNERS=trivy,gitleaks
ANALYSIS_SCANNERS=
# How long the fake provider "scans", in seconds.
ANALYSIS_FAKE_DELAY_SECONDS=4
# Dev knob: set 1 to make the fake provider fail (exercises the FAILED path).
ANALYSIS_FAKE_FAIL=0
# How long a run sits in QUEUED before dispatch.
ANALYSIS_QUEUED_HOLD_SECONDS=2
# Hard cap on one provider execution before the run is marked FAILED.
ANALYSIS_RUN_TIMEOUT_SECONDS=120

# ── Trivy (Sprint 5A) ────────────────────────────────────────────────
# Trivy executable path (must be in PATH, or an absolute path).
# Install: https://trivy.dev/latest/getting-started/installation/
TRIVY_EXECUTABLE=trivy
# Timeout for a single Trivy scan (seconds).
TRIVY_TIMEOUT_SECONDS=120

# ── Restart recovery (Sprint 8) ────────────────────────────────────────
# Mark stranded queued/running analysis runs as failed at startup.
REAPER_ENABLED=true

# ── Observability ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
