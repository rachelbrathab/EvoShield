# EvoShield — docker compose environment template (Sprint 8).
#
#   cp .env.compose.example .env.compose
#   docker compose --env-file .env.compose up --build
#
# NEVER commit .env.compose with real values.

# ── Database ────────────────────────────────────────────────────────────
# Local container default is fine for the demo. For Supabase, point the
# backend DATABASE_URL construction at your pooler instead (see compose).
POSTGRES_USER=evoshield
POSTGRES_PASSWORD=evoshield
POSTGRES_DB=evoshield

# ── Session security (REQUIRED) ─────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_JWT_SECRET=
# true when served over HTTPS in production.
SESSION_COOKIE_SECURE=false

# ── GitHub OAuth App ────────────────────────────────────────────────────
# Callback: ${BACKEND_PUBLIC_URL}/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ── Public URLs ─────────────────────────────────────────────────────────
# Where the browser reaches each app (build-time inlined for the frontend).
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000

# ── Ports ───────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── Runtime ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
# Comma-separated scanners; default runs the full toolchain.
ANALYSIS_SCANNERS=trivy,gitleaks,semgrep,grype

# ── Session cookie name (optional; defaults to "evoshield_session") ──────
# Only change if you need a custom cookie name. Must match what the frontend
# sends — the default is fine for the demo.
SESSION_COOKIE_NAME=

# ── GitHub OAuth (required for repository import/sync) ───────────────────
# OAuth App: https://github.com/settings/developers
# Set GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET to enable GitHub integration.
# The callback URL must be configured in the OAuth App settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Absolute callback URL, e.g. http://localhost:8000/api/v1/auth/oauth/github/callback
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

# ── Scanner configuration (optional; defaults match the container) ───────
# ANALYSIS_SCANNERS=trivy,gitleaks,semgrep,grype
# TRIVY_EXECUTABLE=trivy
# GITLEAKS_EXECUTABLE=gitleaks
# SEMGREP_EXECUTABLE=semgrep
# SYFT_EXECUTABLE=syft
# GRYPE_EXECUTABLE=grype
