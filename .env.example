# ═══════════════════════════════════════════════════════════════════════
# EvoShield — environment variables
# Copy to .env (each app has its own .env.example with app-scoped vars).
# NEVER commit real values. See docs/architecture.md for ownership rules.
# ═══════════════════════════════════════════════════════════════════════

# ── Backend (apps/backend) ────────────────────────────────────────────
# Postgres-first; SQLite fallback used only for local zero-setup dev.
# Production: Supabase Postgres pooler, e.g.
#   postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://evoshield:evoshield@localhost:5432/evoshield
# Local dev without a database:  DATABASE_URL=sqlite+aiosqlite:///./evoshield-dev.db

# Supabase (Sprint 2+). https://supabase.com/dashboard → Project → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# GitHub OAuth App (Sprint 2+). https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Security scanners (Sprint 5+): Trivy / Syft / Grype / Semgrep / Gitleaks
# Where the container-or-worker executes scans.
SCANNER_IMAGE=ghcr.io/evoshield/scanner:latest

# ── Frontend (apps/frontend) ──────────────────────────────────────────
# Public URL of the FastAPI backend. Prefix NEXT_PUBLIC_ → bundled client-side.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Canonical site URL (metadata/OG tags). Set to your real domain in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Auth ──────────────────────────────────────────────────────────────
# "auto" (default) / "supabase" / "local". Local is the zero-dependency dev fallback.
AUTH_PROVIDER=auto
SESSION_JWT_SECRET=dev-only-session-secret-change-me-0123456789
FRONTEND_URL=http://localhost:3000

# ── Runtime ───────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
